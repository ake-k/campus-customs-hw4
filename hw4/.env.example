# Copy this file to .env (in the hw4/ folder) and fill in real values.
# Never commit the real .env.

# Portkey API key used for the chatbot's OpenAI calls
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional model settings (these are the defaults)
CHAT_MODEL=gpt-6-luna
CHAT_REASONING_EFFORT=low
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: folder that holds campus_customs.db and products/.
# If unset, the backend looks in hw4/data/ and then ../data/.
DATA_DIR=

# Optional chat limits per shopper (guests are also capped per IP at 4x these)
CHAT_LIMIT_PER_MINUTE=8
CHAT_LIMIT_PER_DAY=150

# Optional: set to true when the site is served over HTTPS (marks cookies Secure)
COOKIE_SECURE=false
